{
  "name": "raceworld",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node -e \"require('./src/lib/db/client').getDb()\"",
    "news:play": "tsx scripts/news-playthrough.ts",
    "history:check": "tsx scripts/history-check.ts",
    "desktop": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@faker-js/faker": "^10.4.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.wpinrui.raceworld",
    "productName": "RaceWorld",
    "asar": true,
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "npmRebuild": false,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "RaceWorld-${version}-portable.exe"
    }
  }
}
